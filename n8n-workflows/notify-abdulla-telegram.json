        "jsCode": "const crypto = require('crypto');\nconst secret = $env.N8N_WEBHOOK_SECRET || '';\nconst rawBase64 = $input.item.binary?.data?.data || '';\nconst raw = Buffer.from(rawBase64, 'base64').toString('utf8');\nconst expected = crypto.createHmac('sha256', secret).update(raw).digest('hex');\nconst received = ($input.item.json.headers && $input.item.json.headers['x-horizonx-signature']) || '';\nreturn [{ json: { ...$input.item.json, signatureValid: expected === received } }];"
      },
      "id": "verify-signature",
      "name": "Verify HMAC Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 320]
