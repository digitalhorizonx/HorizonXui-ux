{
  "name": "horizonx-agentic-os-backend",
  "version": "0.1.0",
  "private": true,
  "description": "HorizonX Agentic OS backend — Express + Prisma (SQLite) + node-cron",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.10.0",
    "dotenv": "^16.5.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/express": "^4.17.22",
    "@types/node": "^22.15.0",
    "eslint": "^9.28.0",
    "prisma": "^6.10.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0"
  }
}
