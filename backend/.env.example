# HorizonX Agentic OS — environment variables
# Copy to .env and fill in real values. NEVER commit .env (Hard rule 4).

# --- HorizonX platform Reports API (READ-ONLY access, Hard rule 1) ---
# Base URL of the deployed HorizonX platform, e.g. https://horizonx.site
PLATFORM_BASE_URL=
# Key sent as the X-Report-Key header on GET requests to the Reports API
REPORT_API_KEY=

# --- Anthropic API (Hard rule 5: every call logged to ai_usage) ---
ANTHROPIC_API_KEY=
# Monthly AI budget in USD. When month-to-date cost exceeds this, AI calls stop
# and a banner is shown. Default: 10
AI_BUDGET_USD=10

# --- Auth (single user: Abdulla — Hard rule 9) ---
# bcrypt hash of the admin password. Generate from backend/ with:
#   node -e "require('bcryptjs').hash(process.argv[1], 12).then(console.log)" 'your-password'
ADMIN_PASSWORD_HASH=
# Random secret for signing session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- n8n execution webhooks (Phase 4) ---
# Base URL of the n8n instance, e.g. https://n8n.horizonx.site
N8N_WEBHOOK_BASE=
# Shared secret used to HMAC-sign webhook payloads
N8N_WEBHOOK_SECRET=

# --- Server ---
PORT=3000

# --- Database (Prisma + SQLite file DB) ---
DATABASE_URL="file:./data/horizonx-assistant.db"
